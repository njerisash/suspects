DROP TABLE IF EXISTS suspects;

CREATE TABLE suspects(
suspect_id INT PRIMARY KEY,
name VARCHAR(30) NOT NULL,
role VARCHAR(20),
last_seen_place VARCHAR(20),
time_seen VARCHAR(5),
carrying VARCHAR(20),
shoe_size INT,
alibi VARCHAR(40),
status VARCHAR(15) DEFAULT 'Suspect'
);

